rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Since we use simple password auth (not Firebase Auth),
    // we allow read/write access to all authenticated requests.
    // The app handles authorization via session-based login.
    
    // Schedules collection - public can read published, supervisor manages
    match /schedules/{scheduleId} {
      allow read: if true;  // Anyone can view schedules
      allow write: if true; // App handles supervisor check
    }
    
    // Employees collection
    match /employees/{employeeId} {
      allow read, write: if true;
    }
    
    // Entities collection  
    match /entities/{entityId} {
      allow read, write: if true;
    }
    
    // Settings collection
    match /settings/{setting} {
      allow read, write: if true;
    }
    
    // Default deny for unlisted collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
